# =====================================================================
# .env.example —— 环境变量模板（可以提交到 Git，里面没有任何真实密钥）
# =====================================================================
# 【用法】在自己的电脑上复制一份改名为 .env，然后把下面每一项填成自己的值：
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# 【切记】.env 里有真实密钥，永远不要提交、不要发给别人（.gitignore 已屏蔽）
# =====================================================================

# --------------------- DeepSeek 大模型 ---------------------
# 到 https://platform.deepseek.com 注册后自己申请，形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=你的密钥填在这里
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 必须是 deepseek-chat；严禁 deepseek-reasoner（不支持工具调用）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=4000
# 创作温度（0~2）：越高越有创意、故事越不容易雷同；改小（如 0.1）可观察"套路化"现象
DEEPSEEK_TEMPERATURE=0.9

# --------------------- MySQL 数据库 ---------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# 填你安装 MySQL 时设置的密码
MYSQL_PASSWORD=你的数据库密码
MYSQL_DB=children_story_db

# --------------------- RAG 知识库 ---------------------
# 有本地模型目录就填本地路径；没有则填仓库名让它自动下载
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 素材目录与向量索引目录：写相对路径（相对项目根目录）即可。
# config.resolve_path() 会自动补成绝对路径，所以从任何目录启动都正确；
# 而 faiss 读写索引时由 rag_service 自动换回相对路径（faiss 在 Windows 上
# 不认带盘符的绝对路径）—— 详见 README 的坑位说明。
MATERIAL_DIR=data/story_materials
FAISS_INDEX_PATH=data/faiss_index
CHUNK_SIZE=300
CHUNK_OVERLAP=50
RAG_TOP_K=3

# --------------------- Agent ---------------------
AGENT_MAX_ITERATIONS=10
MAX_HISTORY_TURNS=6

# --------------------- 意图路由（决定"要不要弹需求澄清问卷"） ---------------------
# true（默认）：规则法**判不准**时才调一次小模型复核。
#   主流输入（"你好""写个关于分享的故事"）走规则直接出结果，不调模型、零延迟；
#   只有词表外的口语说法（"来点哄睡的""想给孩子听点东西"）才多花约 1 秒。
#   实测：词表外 54 条说法，纯规则判对 35 条，开了兜底判对 54 条。
# false：只用规则法。纯离线、零成本、秒回，但口语说法会漏判（问卷可能不弹）。
#   答辩当天网络不稳、或想演示"无网也能跑"时，设成 false 即可一键降级。
INTENT_FALLBACK=true
# 兜底调用的超时（秒）。连错 2 次会自动熔断 60 秒，期间全部走规则法，永不卡住
INTENT_FALLBACK_TIMEOUT=6
